// ~/.config/waybar/config.jsonc

{
    "position": "top",
    "layer": "top",
    "height": 36,
    "margin": "5 10 0 10",
    "spacing": 4,

    "include":[
        "./modules/workspace.jsonc",
        "./modules/clock.jsonc",
        "./modules/cpu.jsonc",
        "./modules/pulseaudio.jsonc",
        "./modules/battery.jsonc",
        "./modules/power.jsonc"
    ],


    "modules-left": [
        "clock",
        "pulseaudio"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "cpu",
        "tray",
        "battery",
        "custom/power"
    ]
}
